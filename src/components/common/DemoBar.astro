---
// Demo-site only: renders nothing unless PUBLIC_DEMO_BUY_URL is set at build time, so buyer builds are unaffected.
// The text is English-only on purpose (it never ships to a buyer's site), so it isn't in src/i18n/.
// Uses the preloaded body font; this sits above the header (a web font swap here would shift the page)
const href = import.meta.env.PUBLIC_DEMO_BUY_URL;
---

{href && (
  <aside class="border-border border-b">
    <p class="mx-auto max-w-5xl px-4 py-2 text-center">
      <span class="text-primary" aria-hidden="true">
        ¶{' '}
      </span>
      Pilcrow (free) demo · <a href={href}>Get Pro →</a>
    </p>
  </aside>
)}
