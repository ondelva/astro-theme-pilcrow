---
// Link styled as a button. Use as="button" for form submits.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> &
  HTMLAttributes<'button'> & {
    as?: 'a' | 'button';
    variant?: 'primary' | 'secondary';
  };
const { as: Tag = 'a', variant = 'primary', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-foreground text-background hover:bg-primary',
  secondary: 'text-foreground border-foreground/30 hover:border-foreground border',
};
---

<Tag
  class:list={[
    'inline-flex min-h-11 items-center justify-center rounded-xs px-5 font-sans text-sm font-medium no-underline transition-colors disabled:pointer-events-none disabled:opacity-50',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
