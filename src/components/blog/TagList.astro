---
import { useT } from '../../i18n/t';
import { tagHref } from '../../utils/posts';

const t = useT(Astro.currentLocale);

interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul aria-label={t.tags} class="flex flex-wrap gap-x-3 gap-y-1 font-sans text-xs">
    {tags.map((tag) => (
      <li>
        <a href={tagHref(tag)} class="text-muted hover:text-primary no-underline">
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
