---
import { formatDate, postHref, type Post } from '../../utils/posts';
import TagList from './TagList.astro';

interface Props {
  posts: Post[];
  headingLevel?: 'h2' | 'h3';
}
const { posts, headingLevel: Heading = 'h2' } = Astro.props;
---

<ol class="divide-border border-border divide-y border-y">
  {posts.map((post) => (
    <li class="grid gap-x-8 gap-y-2 py-8 sm:grid-cols-[9rem_1fr]">
      <p class="text-muted pt-1.5 font-sans text-sm">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, Astro.currentLocale)}
        </time>
      </p>
      <div class="space-y-2">
        <Heading class="text-2xl font-medium">
          <a href={postHref(post)} class="text-foreground hover:text-primary no-underline">
            {post.data.title}
          </a>
        </Heading>
        <p class="text-muted">{post.data.description}</p>
        <TagList tags={post.data.tags} />
      </div>
    </li>
  ))}
</ol>
