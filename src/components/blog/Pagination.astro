---
import type { Page } from 'astro';
import { useT } from '../../i18n/t';

const t = useT(Astro.currentLocale);

interface Props {
  page: Pick<Page, 'currentPage' | 'lastPage' | 'url'>;
}
const { currentPage, lastPage, url } = Astro.props.page;
---

{lastPage > 1 && (
  <nav aria-label={t.pagination} class="mt-10 flex items-center justify-between font-sans text-sm">
    {url.prev ? (
      <a href={url.prev} rel="prev">
        ← {t.newer}
      </a>
    ) : (
      <span />
    )}
    <span class="text-muted">
      {t.pageOf.replace('{n}', String(currentPage)).replace('{total}', String(lastPage))}
    </span>
    {url.next ? (
      <a href={url.next} rel="next">
        {t.older} →
      </a>
    ) : (
      <span />
    )}
  </nav>
)}
