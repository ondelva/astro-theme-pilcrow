---
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  body: string;
  action: { label: string; href: string };
}
const { title, body, action } = Astro.props;
---

<section class="hang mx-auto max-w-5xl px-4 py-24">
  <div class="border-border border-t pt-10 lg:col-start-2">
    <h2 class="max-w-2xl text-4xl">{title}</h2>
    <p class="text-muted mt-4 max-w-prose text-lg">{body}</p>
    <Button href={action.href} class="mt-8">
      {action.label}
    </Button>
  </div>
</section>
