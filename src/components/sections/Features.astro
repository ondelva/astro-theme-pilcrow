---
interface Props {
  title: string;
  items: { title: string; body: string }[];
}
const { title, items } = Astro.props;
const numerals = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii', 'ix', 'x'];
---

<section class="hang mx-auto max-w-5xl px-4 py-14">
  <h2 class="section-label lg:pt-5">{title}</h2>
  <ol class="divide-border border-border divide-y border-y">
    {items.map((item, i) => (
      <li class="grid items-baseline gap-x-6 gap-y-1 py-5 sm:grid-cols-[2.5rem_1fr] md:grid-cols-[2.5rem_14rem_1fr]">
        <span class="text-primary text-lg italic" aria-hidden="true">
          {numerals[i] ?? i + 1}.
        </span>
        <h3 class="text-xl font-medium">{item.title}</h3>
        <p class="text-muted sm:col-start-2 md:col-start-auto">{item.body}</p>
      </li>
    ))}
  </ol>
</section>
