---
import type { Post } from '../../utils/posts';
import PostList from '../blog/PostList.astro';

interface Props {
  title: string;
  posts: Post[];
  moreLabel?: string;
  moreHref?: string;
}
const { title, posts, moreLabel, moreHref } = Astro.props;
---

<section class="hang mx-auto max-w-5xl px-4 py-12">
  <div class="lg:pt-8">
    <h2 class="section-label">{title}</h2>
    {moreHref && moreLabel && (
      <a href={moreHref} class="mt-1 inline-block font-sans text-sm">
        {moreLabel} →
      </a>
    )}
  </div>
  <PostList posts={posts} headingLevel="h3" />
</section>
