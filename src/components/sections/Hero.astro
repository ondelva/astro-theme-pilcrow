---
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede: string;
  actions?: { label: string; href: string; variant?: 'primary' | 'secondary' }[];
}
const { eyebrow, title, lede, actions = [] } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 pt-14 pb-12 sm:pt-24 sm:pb-16">
  {eyebrow && (
    <p class="section-label">
      <span class="text-primary not-italic" aria-hidden="true">
        ¶{' '}
      </span>
      {eyebrow}
    </p>
  )}
  <h1 class="mt-3 max-w-3xl text-5xl font-light tracking-tight sm:text-6xl">{title}</h1>
  <p class="text-muted mt-6 max-w-prose text-xl">{lede}</p>
  {actions.length > 0 && (
    <div class="mt-8 flex flex-wrap gap-3">
      {actions.map(({ label, href, variant }) => (
        <Button href={href} variant={variant}>
          {label}
        </Button>
      ))}
    </div>
  )}
</section>
