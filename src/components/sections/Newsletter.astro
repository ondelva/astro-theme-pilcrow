---
// Static form. action is your newsletter service's subscribe URL. Submitting is disabled while it's empty.
import { useT } from '../../i18n/t';
import Button from '../ui/Button.astro';

const t = useT(Astro.currentLocale);

interface Props {
  title: string;
  body: string;
  action?: string;
  field?: string; // name of the email input; some services expect a different one
  hidden?: Record<string, string>;
}
const { title, body, action, field = 'email', hidden = {} } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-20">
  <div class="border-foreground grid gap-x-10 gap-y-6 border-t-2 pt-8 md:grid-cols-2">
    <div>
      <h2 class="text-3xl">{title}</h2>
      <p class="text-muted mt-3">{body}</p>
    </div>
    <div>
      <form
        action={action || undefined}
        method="post"
        target="_blank"
        class="flex flex-col gap-3 sm:flex-row md:mt-2"
      >
        {Object.entries(hidden).map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        <label for="newsletter-email" class="sr-only">
          {t.emailLabel}
        </label>
        <input
          id="newsletter-email"
          name={field}
          type="email"
          required
          autocomplete="email"
          placeholder={t.emailLabel}
          class="border-foreground/50 bg-background placeholder:text-muted focus-visible:border-primary min-h-11 flex-1 rounded-xs border px-4 font-sans text-sm"
        />
        <Button as="button" type="submit" disabled={!action}>
          {t.subscribe}
        </Button>
      </form>
      {!action && <p class="text-muted mt-3 font-sans text-xs">{t.formNotConfigured}</p>}
    </div>
  </div>
</section>
