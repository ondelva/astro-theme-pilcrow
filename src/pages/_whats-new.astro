---
// Demo-site only: the theme's own CHANGELOG.md at /whats-new, so a visitor can see what each
// release added and follow its links to the demo pages that show it. astro.config.mjs injects the
// route only when PUBLIC_DEMO_BUY_URL is set, so buyer builds never have it. English-only, like
// the demo bar. The changelog's own "# Changelog" heading is hidden: the layout sets the title.
import { Content } from '../../CHANGELOG.md';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="What's new" description="Every release of the theme, newest first.">
  <div class="whats-new">
    <Content />
  </div>
</PageLayout>

<style>
  .whats-new :global(h1) {
    display: none;
  }
</style>
