---
// Home. Change section order and copy here. Section components live in src/components/sections/.
// A writer's home page: a short introduction, then the latest posts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import RecentPosts from '../components/sections/RecentPosts.astro';
import { useT } from '../i18n/t';
import { getPosts } from '../utils/posts';
import { forms } from '../config';

const t = useT(Astro.currentLocale);

const recent = (await getPosts()).slice(0, 6);
---

<BaseLayout>
  <Hero
    eyebrow="Ada Marlow’s notebook"
    title="Reading slowly, and writing about it."
    lede="Essays on the books that take me a month to finish, the notes I leave in their margins, and the few habits of print I refuse to give up. A new one turns up every few weeks."
  />
  <RecentPosts title="Recent writing" posts={recent} moreLabel={t.allPosts} moreHref="/blog/" />
  <Newsletter
    title="The Sunday letter"
    body="The week’s essay, three things worth reading, and a closing line. Every letter has an unsubscribe link at the bottom."
    action={forms.newsletter.action}
  />
</BaseLayout>
