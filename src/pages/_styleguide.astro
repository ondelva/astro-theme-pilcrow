---
// Dev-only token preview. astro.config.mjs mounts it at /styleguide during `astro dev` only (the _ prefix keeps it out of builds).
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';

const colors = ['background', 'foreground', 'muted', 'border', 'primary'];
const sizes = [
  'text-6xl',
  'text-5xl',
  'text-4xl',
  'text-3xl',
  'text-2xl',
  'text-xl',
  'text-lg',
  'text-base',
  'text-sm',
];
---

<BaseLayout title="Styleguide" noindex>
  <div class="max-w-prose mx-auto space-y-16 px-4 py-12">
    <header class="flex items-center justify-between">
      <h1 class="text-4xl font-medium">
        Styleguide <span class="text-primary">¶</span>
      </h1>
      <ThemeToggle />
    </header>

    <section class="space-y-4">
      <h2 class="section-label">Colors</h2>
      <ul class="grid grid-cols-2 gap-4 font-sans text-sm sm:grid-cols-5">
        {colors.map((c) => (
          <li>
            <div
              class="border-border h-16 rounded border"
              style={`background: var(--color-${c})`}
            />
            <code class="font-mono text-xs">{c}</code>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="section-label">Type scale — Newsreader</h2>
      {sizes.map((s) => (
        <p class={`${s} leading-tight`}>{s} Ink &amp; paper</p>
      ))}
      <p class="text-3xl font-light italic">Light italic, optical size</p>
    </section>

    <section class="space-y-4">
      <h2 class="section-label">Body</h2>
      <p>
        The pilcrow was once written in <a href="#">red ink</a> by a rubricator, a scribe whose only
        job was to add the marks the copyist left space for. <em>Some manuscripts</em> still show
        the empty gaps where the red never came.
        <strong>Weight</strong> and <code class="font-mono text-[0.9em]">inline code</code> sit in
        the same line.
      </p>
      <p class="text-muted">Muted text for dates, captions and metadata.</p>
      <hr class="border-border" />
      <p class="font-sans text-sm">Inter for interface: buttons, labels, navigation. 0123456789</p>
      <pre class="border-border overflow-x-auto rounded border p-4 font-mono text-sm"><code>const pilcrow = '¶'; // JetBrains Mono</code></pre>
      <button class="rounded-xs bg-foreground px-5 py-2 font-sans text-sm text-background">
        Focusable button
      </button>
    </section>
  </div>
</BaseLayout>
