---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useT } from '../i18n/t';

const t = useT(Astro.currentLocale);
---

<BaseLayout title={t.notFoundTitle} description={t.notFoundBody} noindex>
  <div class="max-w-prose mx-auto px-4 py-24 text-center">
    <p class="text-primary text-7xl" aria-hidden="true">
      ¶
    </p>
    <h1 class="mt-6 text-4xl font-medium">{t.notFoundTitle}</h1>
    <p class="text-muted mt-4 text-lg">{t.notFoundBody}</p>
    <p class="mt-10 font-sans text-sm">
      <a href="/">{t.backHome}</a>
    </p>
  </div>
</BaseLayout>
