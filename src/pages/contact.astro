---
// The form posts to Web3Forms. The access key is forms.web3formsKey in src/config.ts.
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import { forms, site } from '../config';
import { useT } from '../i18n/t';

const t = useT(Astro.currentLocale);

const ready = Boolean(forms.web3formsKey);
const field =
  'border-border bg-background focus-visible:border-primary w-full rounded-lg border px-4 py-2.5 font-sans text-base';
---

<PageLayout
  title="Contact"
  description="Questions, corrections, or a note about an essay. I read all of it."
>
  <form
    action="https://api.web3forms.com/submit"
    method="post"
    class="not-prose space-y-5 font-sans text-sm"
  >
    <input type="hidden" name="access_key" value={forms.web3formsKey} />
    <input type="hidden" name="subject" value={`New message from ${site.name}`} />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
    <div class="space-y-1.5">
      <label for="contact-name" class="block font-medium">
        {t.nameLabel}
      </label>
      <input id="contact-name" name="name" required autocomplete="name" class={field} />
    </div>
    <div class="space-y-1.5">
      <label for="contact-email" class="block font-medium">
        {t.emailLabel}
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        class={field}
      />
    </div>
    <div class="space-y-1.5">
      <label for="contact-message" class="block font-medium">
        {t.messageLabel}
      </label>
      <textarea id="contact-message" name="message" rows="6" required class={field}></textarea>
    </div>
    <Button as="button" type="submit" disabled={!ready}>
      {t.send}
    </Button>
    {!ready && <p class="text-muted text-xs">{t.formNotConfigured}</p>}
  </form>
</PageLayout>
